# ========================================================
# BIẾN MÔI TRƯỜNG MẪU CHO HỆ THỐNG CRM SUPPORT SYSTEM
# ========================================================

# Cơ sở dữ liệu PostgreSQL
DB_USER=crm_user
DB_PASSWORD=YourStrongDbPassword!
DB_NAME=crm_db

# Bảo mật Backend (JWT & Scrypt Salt)
JWT_SECRET=YourSuperSecretJwtKey2026!
PASSWORD_SALT=YourSaltValue2026!

# Quản trị Database pgAdmin 4
PGADMIN_DEFAULT_EMAIL=admin@crm.com
PGADMIN_DEFAULT_PASSWORD=YourStrongPgAdminPassword!

# Quản trị Dashboard Grafana
GF_SECURITY_ADMIN_PASSWORD=YourStrongGrafanaPassword!
